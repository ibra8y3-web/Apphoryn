{
  "name": "apphoryn-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Apphoryn open-source software store desktop client",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.apphoryn.store",
    "productName": "Apphoryn",
    "asar": true,
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "asset-server.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;Utility;",
      "maintainer": "Apphoryn Community <noreply@github.com>",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "author": {
    "name": "Apphoryn Community",
    "email": "noreply@github.com"
  },
  "homepage": "https://github.com/ibra8y3-web/Apphoryn",
  "desktopName": "com.apphoryn.store"
}
