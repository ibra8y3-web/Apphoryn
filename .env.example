# Core application
APPHORYN_NAME=Apphoryn
APPHORYN_DATABASE=./storage/apphoryn.sqlite3
APPHORYN_STORAGE=./storage/artifacts
APPHORYN_PUBLIC_BASE_URL=https://store.example.org
APPHORYN_CORS_ORIGINS=
APPHORYN_MAX_ARTIFACT_BYTES=1073741824
APPHORYN_MAX_IMPORT_BYTES=536870912

# GitHub and application security
APPHORYN_GITHUB_TOKEN=
APPHORYN_ADMIN_TOKEN=replace-with-a-long-random-admin-token
APPHORYN_INGEST_TOKEN=replace-with-a-different-long-random-ingest-token
APPHORYN_GITHUB_OWNER=your-github-owner
APPHORYN_GITHUB_REPOSITORY=Apphoryn
APPHORYN_GITHUB_REF=main
APPHORYN_BUILD_WORKFLOW=build-community-app.yml

# Legacy single-provider fallback (optional)
APPHORYN_AI_BASE_URL=https://api.openai.com/v1
APPHORYN_AI_API_KEY=
APPHORYN_AI_MODEL=

# Apphoryn multi-provider AI rotation (add these as GitHub Actions Secrets / deployment secrets)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COMET_API_KEY=
CLOUDFLARE_API_TOKEN=
# Cloudflare also requires this account identifier (not a secret)
CLOUDFLARE_ACCOUNT_ID=

# Free-only is the safe default. Some providers do not expose billing tier in their model-list API.
# Keep this false unless the provider console confirms the account is on its free tier.
APPHORYN_AI_FREE_ONLY=true
APPHORYN_AI_ALLOW_LEGACY_PROVIDER=false
APPHORYN_AI_CONFIRM_GEMINI_GROQ_FREE_TIER=false
APPHORYN_AI_PROVIDER_PRIORITY=ollama,vllm,gemini,groq,xai,openrouter,cloudflare,comet
APPHORYN_AI_MODELS_CACHE_SECONDS=900
# Comet uses credit/trial balance; do not enable unless you intentionally allow that.
APPHORYN_AI_ALLOW_CREDIT_BASED_PROVIDERS=false
APPHORYN_COMET_FREE_MODEL_IDS=
# Cloudflare may incur account-specific charges; opt in only after checking the account.
APPHORYN_AI_ENABLE_CLOUDFLARE=false

# xAI Grok is a metered API, not a free Groq model. Keep disabled unless paid API use is approved.
XAI_API_KEY=
APPHORYN_AI_ENABLE_XAI=false
APPHORYN_AI_ALLOW_PAID_REQUESTS=false

# Persistent multi-agent backend worker. The agent database is separate from the store catalogue.
APPHORYN_AGENT_DATABASE=./storage/agent-workforce.sqlite3
APPHORYN_AGENT_WORKERS=2
APPHORYN_AGENT_TASK_CONCURRENCY=3

# Explicitly gated GitHub hosted compute and source-code pull requests
APPHORYN_GITHUB_COMPUTE_ENABLED=false
APPHORYN_CODE_WRITES_ENABLED=false
APPHORYN_CODE_WRITE_ALLOWLIST=app,tests,scripts,apps/web
# If blank, code PRs are restricted to APPHORYN_GITHUB_OWNER/APPHORYN_GITHUB_REPOSITORY.
APPHORYN_CODE_WRITE_REPOSITORIES=

# Optional self-hosted model servers (Docker Compose private network)
# For docker-compose --profile local-ai set OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
VLLM_BASE_URL=
VLLM_API_KEY=
APPHORYN_AI_PREFER_LOCAL=true
APPHORYN_AI_DISCOVERY_TIMEOUT_SECONDS=3

# Analytics: local SQLite is the durable source of truth. Configure one remote replica if desired.
APPHORYN_ANALYTICS_DATABASE=./storage/analytics.sqlite3
APPHORYN_ANALYTICS_POSTGRES_DSN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Compose binds to localhost by default. Set 0.0.0.0 only behind a firewall and authenticated TLS proxy.
APPHORYN_BIND=127.0.0.1

# Source-build targets; empty means mirror existing verified releases only.

# CENTRAL_PORTAL_USERNAME is an account login, not an AI API credential; it is not read by the AI router.

# Autonomous catalog watcher duty cycle (rest 0 = continuous)
APPHORYN_AGENT_WORK_MINUTES=60
APPHORYN_AGENT_REST_MINUTES=0

# Behind a reverse proxy (Render, Railway, Nginx, Caddy, Cloudflare...) set the number of
# trusted proxies so rate limits and admin lockouts apply per real visitor, not to everyone at once.
APPHORYN_TRUSTED_PROXY_HOPS=0
# APPHORYN_TRUST_CLOUDFLARE=true

# Wrong admin passwords: 0 = unlimited attempts, never locked out (default). N = lock a visitor for 10 min after N failures.
APPHORYN_ADMIN_MAX_FAILED=0
